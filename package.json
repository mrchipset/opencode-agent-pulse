{
  "name": "opencode-agent-pulse",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode TUI plugin that live-displays running subagents in the sidebar with busy/idle status, elapsed time, and click-through to the sub-session context.",
  "license": "MIT",
  "author": "zouyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrchipset/opencode-agent-pulse.git"
  },
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "subagent",
    "sub-agent",
    "sidebar",
    "agent"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": "^2.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts && bun run scripts/fix-sourcemaps.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke-2.0.ts && bun --preload @opentui/solid/preload scripts/render-smoke.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opencode/theme": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^24",
    "@types/node-notifier": "^8.0.5",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.18",
    "typescript": "^5"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
